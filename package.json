{
  "name": "staff-attendance-portal",
  "version": "1.0.0",
  "type": "module",
  "description": "Lifecard Staff Attendance Portal with GPS verification",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "build": "echo 'No build required'",
    "lint": "echo 'No lint required'",
    "start": "node server.js",
    "version:bump": "node -e \"let f=require('fs'),p='version.js',v=+f.readFileSync(p,'utf8').match(/\\d+/)[0]+1;f.writeFileSync(p,'const APP_VERSION = '+v+';\\n');console.log('Bumped to v'+v)\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0"
  }
}
